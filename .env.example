POSTGRES_USER=odonto
POSTGRES_PASSWORD=troque_por_uma_senha_local
POSTGRES_DB=odonto_pro
POSTGRES_PORT=5432

# Mantenha usuário, senha, banco e porta em sincronia com os valores acima.
# Caracteres especiais na senha precisam de URL encoding nesta URL.
DATABASE_URL="postgresql://odonto:troque_por_uma_senha_local@localhost:5432/odonto_pro?schema=public"

# Auth.js: gere um segredo aleatório e configure um OAuth App no GitHub.
# Callback local: http://localhost:3000/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
